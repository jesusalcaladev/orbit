{
  "name": "@orbit/rate-limit",
  "version": "0.0.1",
  "description": "First-party rate limiting for @orbit/core — a dependency-free token-bucket plugin that gates queries AND mutations (per IP, per token, or any context key).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "orbit",
    "rate-limit",
    "token-bucket",
    "security",
    "data-layer"
  ],
  "license": "MIT",
  "dependencies": {
    "@orbit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
