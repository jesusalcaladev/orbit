{
  "name": "@orbit/express",
  "version": "0.0.1",
  "description": "Express middleware for @orbit/core — mount the full Orbit protocol (JSON, MessagePack, SSE streaming, uploads) on any Express app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "orbit",
    "express",
    "middleware",
    "data-layer",
    "protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@orbit/core": "workspace:*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
