{
  "name": "@orbit/metrics",
  "version": "0.1.0",
  "description": "First-party production metrics for @orbit/core — a dependency-free collector that instruments any Orbit handler: request counts, error codes, cache hit ratio, rate-limit rejections and latency percentiles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "orbit",
    "metrics",
    "observability",
    "production",
    "data-layer"
  ],
  "license": "MIT",
  "dependencies": {
    "@orbit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
