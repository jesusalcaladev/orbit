{
  "name": "@orbit/redis",
  "version": "0.1.0",
  "description": "Redis-backed CacheStore for @orbit/core — production caching with TTL, SWR and prefix invalidation for multi-instance deploys.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "orbit",
    "redis",
    "cache",
    "stale-while-revalidate",
    "data-layer"
  ],
  "license": "MIT",
  "dependencies": {
    "@orbit/core": "workspace:*"
  },
  "devDependencies": {
    "@orbit/rate-limit": "workspace:*",
    "@types/node": "^24.0.0",
    "redis": "^6.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
